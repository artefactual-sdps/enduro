{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "preview": "vite preview",
    "lint": "run-s lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "run-s format:check",
    "format:check": "prettier --check .",
    "format:fix": "prettier --fix .",
    "test": "vitest run",
    "check": "run-s lint format type-check test build-only",
    "coverage": "vitest run --coverage",
    "deps": "run-s deps:minor",
    "deps:semver": "ncu --target=semver --format=group --interactive",
    "deps:major": "ncu --target=latest --format=group --interactive",
    "deps:minor": "ncu --target=minor --format=group --interactive"
  },
  "dependencies": {
    "@pinia/plugin-debounce": "^2.0.0",
    "@popperjs/core": "^2.11.8",
    "@types/humanize-duration": "^3.27.4",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/vue": "^3.2.0",
    "@uppy/xhr-upload": "^5.2.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.2.1",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.13",
    "eventsource": "^4.1.1",
    "humanize-duration": "^3.34.0",
    "moment": "^2.30.1",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.0.2",
    "ts-debounce": "^5.0.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "overrides": {
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.513",
    "@pinia/testing": "^2.0.1",
    "@testing-library/vue": "^8.1.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/bootstrap": "^5.2.11",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.9.1",
    "bootstrap": "^5.3.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "lodash-es": "^4.18.1",
    "npm-check-updates": "^23.0.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.3.9"
  }
}
